# ===============================================
# Café Companion — Environment Configuration
# ===============================================

# 1. Google Gemini AI Engine
# Get key at: https://aistudio.google.com
GEMINI_API_KEY=your_gemini_api_key_here

# 2. Google Maps Platform
# Enable Maps JavaScript API, Places API, and Geocoding API in Google Cloud Console
VITE_GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# 3. Firebase Configuration (Web Client)
# Found in Firebase Console > Project Settings > General > Your Apps
VITE_FIREBASE_API_KEY=AIzaSyExampleKey123
VITE_FIREBASE_AUTH_DOMAIN=cafe-companion-demo.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=cafe-companion-demo
VITE_FIREBASE_STORAGE_BUCKET=cafe-companion-demo.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789012
VITE_FIREBASE_APP_ID=1:123456789012:web:abcdef123456

# 4. Backend Service Port (Express / Cloud Run)
PORT=5000

# 5. Sports Data API (Optional for external match feeds)
SPORTS_DATA_API_KEY=your_sports_api_key_here
